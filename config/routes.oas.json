{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "My Zuplo API"
  },
  "paths": {
    "/v1/todos": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Get all todos",
        "description": "",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlRewriteHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "rewritePattern": "https://jsonplaceholder.typicode.com/todos"
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound",
              "require-admin",
              "rate-limit-inbound"
            ]
          }
        },
        "operationId": "9967c137-ee35-40fb-983a-fe090c36b249"
      }
    },
    "/path-1": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "New Route",
        "description": "",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://getting-started.zuplo.io"
            }
          },
          "policies": {
            "inbound": []
          }
        },
        "operationId": "15bad9a4-7b6c-40cc-92b1-950e2cf5a29e",
        "x-internal": true
      }
    }
  }
}